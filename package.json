{
  "name": "hklivenews",
  "displayName": "HK Live News",
  "description": "Read latest HK news from RTHK and other sources.",
  "publisher": "mchu1966",
  "version": "1.0.7",
  "icon": "resources/hklivenews-icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mchu1966/hklivenews.git"
  },
  "bugs": {
    "url": "https://github.com/mchu1966/hklivenews/issues"
  },
  "homepage": "https://github.com/mchu1966/hklivenews#readme",
  "keywords": [
    "hong-kong",
    "news",
    "rthk",
    "status-bar"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onChatParticipant:news-chat.reporter"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hklivenews.start",
        "title": "HK Live News: Start Refreshing HK News (default 5 mins)"
      },
      {
        "command": "hklivenews.refresh",
        "title": "HK Live News: Manually refresh HK News"
      },
      {
        "command": "hklivenews.stop",
        "title": "HK Live News: Stop Refreshing HK News"
      },
      {
        "command": "hklivenews.next",
        "title": "HK Live News: Show Next HK News Headline"
      },
      {
        "command": "hklivenews.prev",
        "title": "HK Live News: Show Previous HK News Headline"
      },
      {
        "command": "hklivenews.selectHeadline",
        "title": "HK Live News: Select HK News Headline"
      },
      {
        "command": "hklivenews.configureSources",
        "title": "HK Live News: Configure News Sources"
      },
      {
        "command": "hklivenews.toggleLatestHeadlineNotifications",
        "title": "HK Live News: Toggle Latest Headline Notifications"
      },
      {
        "command": "hklivenews.resetLatestHeadlineNotificationSnooze",
        "title": "HK Live News: Reset Latest Headline Notification Snooze"
      }
    ],
    "keybindings": [
      {
        "command": "hklivenews.next",
        "key": "alt+d"
      },
      {
        "command": "hklivenews.prev",
        "key": "alt+a"
      }
    ],
    "configuration": {
      "title": "HK Live News",
      "properties": {
        "hklivenews.sources": {
          "type": "array",
          "default": [
            "rthk"
          ],
          "uniqueItems": true,
          "scope": "window",
          "description": "News sources to combine when refreshing headlines.",
          "items": {
            "type": "string",
            "enum": [
              "rthk",
              "now"
            ],
            "enumDescriptions": [
              "RTHK Chinese latest news",
              "Now News local news"
            ]
          }
        },
        "hklivenews.latestHeadlineNotifications": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Show a notification when a new HK News headline is being fetched."
        }
      }
    },
    "views": {
      "newsContainer": [
        {
          "id": "mainNewsContainer",
          "name": "HK Live News"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "newsContainer",
          "title": "HK Live News",
          "icon": "resources/view-icon.svg"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "news-chat.reporter",
        "fullName": "HK Live News Reporter",
        "name": "hklivenews-reporter",
        "description": "What do you want to know about today's HK news?",
        "isSticky": true,
        "commands": [
          {
            "name": "hk-news-today",
            "description": "Summarize today's HK news headlines"
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile && pnpm run bundle",
    "bundle": "esbuild ./out/extension.js --bundle --platform=node --format=cjs --outfile=dist/extension.js --external:vscode",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./ & esbuild ./src/extension.ts --bundle --platform=node --format=cjs --outfile=dist/extension.js --external:vscode --watch",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  }
}